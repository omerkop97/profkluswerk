---
/**
 * Voiceglow chatwidget. Laadt van een externe CDN, dus dit is het enige
 * onderdeel van de site dat zwaar extern JavaScript meebrengt. Bewust met
 * `defer` en helemaal onderaan de body, zodat de pagina zelf niet wacht.
 *
 * Let op: de widget verwerkt wat bezoekers intypen. Dat staat benoemd in de
 * privacyverklaring, zie src/pages/privacy.astro.
 */
const AGENT_ID = 'GLDAVUcu9Tqtfk60cAZ1';
const REGIO = 'eu';
---

<div style="width: 0; height: 0;" id="VG_OVERLAY_CONTAINER"></div>

<script is:inline define:vars={{ AGENT_ID, REGIO }}>
  (function () {
    window.VG_CONFIG = {
      ID: AGENT_ID,
      region: REGIO,
      render: 'bottom-right',
      stylesheets: ['https://vg-bunny-cdn.b-cdn.net/vg_live_build/styles.css'],
    };
    var VG_SCRIPT = document.createElement('script');
    VG_SCRIPT.src = 'https://vg-bunny-cdn.b-cdn.net/vg_live_build/vg_bundle.js';
    VG_SCRIPT.defer = true;
    document.body.appendChild(VG_SCRIPT);
  })();
</script>

<style is:global>
  /*
   * Op mobiel staat onze eigen actiebalk (Bellen / WhatsApp / Offerte) onderaan
   * vastgeplakt. Zonder deze regel valt de chatknop daar bovenop.
   *
   * De widget zet zijn onderdelen op verschillende bottom-waarden (40, 80, 128
   * en 180px). Die overschrijven met één waarde zou ze op elkaar stapelen,
   * vandaar een verschuiving van het geheel in plaats daarvan.
   */
  @media (max-width: 1023px) {
    #VG_OVERLAY_CONTAINER [class*='vg-fixed'] {
      transform: translateY(-4.75rem);
    }
  }
</style>
