---
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import { BEDRIJF, WERKWIJZE } from '../../consts';
---

<Base
  titel="Bedankt voor uw aanvraag | Prof Kluswerk"
  omschrijving="Uw offerteaanvraag is verstuurd. Wij nemen binnen één werkdag contact met u op."
  noindex
>
  <section class="bg-shell py-20 lg:py-28">
    <div class="container-page max-w-3xl">
      <div class="rounded-2xl border border-navy-100 bg-white p-8 text-center sm:p-12">
        <span
          class="inline-flex h-16 w-16 items-center justify-center rounded-full bg-gold-500 text-navy-900"
        >
          <Icon naam="check" class="h-8 w-8" />
        </span>

        <h1 class="mt-7 text-3xl uppercase sm:text-4xl">Bedankt voor uw aanvraag</h1>

        <p class="mt-5 text-lg leading-relaxed text-navy-700">
          Wij hebben uw aanvraag ontvangen en nemen <strong class="text-navy-900"
            >binnen één werkdag</strong
          > contact met u op. Heeft u haast? Bel of app gerust, dan pakken we het
          meteen op.
        </p>

        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <Button href={BEDRIJF.telefoonLink} formaat="lg">
            <Icon naam="telefoon" class="h-4 w-4" />
            {BEDRIJF.telefoonWeergave}
          </Button>
          <Button
            href={BEDRIJF.whatsapp}
            variant="outline-donker"
            formaat="lg"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon naam="whatsapp" class="h-4 w-4" />
            WhatsApp
          </Button>
        </div>
      </div>

      <div class="mt-12">
        <h2 class="eyebrow text-center text-gold-700">Hoe het verder gaat</h2>
        <ol class="mt-8 grid gap-8 sm:grid-cols-3">
          {
            WERKWIJZE.map((stap) => (
              <li class="border-t-4 border-navy-100 pt-5">
                <span class="font-display text-2xl font-extrabold text-navy-200">
                  {stap.stap}
                </span>
                <h3 class="mt-1 font-display text-base font-extrabold text-navy-900 uppercase">
                  {stap.titel}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-navy-700">{stap.tekst}</p>
              </li>
            ))
          }
        </ol>
      </div>

      <p class="mt-12 text-center">
        <a
          href="/"
          class="font-display text-[0.8rem] font-bold tracking-wide text-navy-800 uppercase underline hover:text-gold-700"
        >
          Terug naar de homepage
        </a>
      </p>
    </div>
  </section>
</Base>
