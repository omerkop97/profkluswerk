---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import BrushEdge from '../components/BrushEdge.astro';
import CtaBand from '../components/CtaBand.astro';
import FotoPlaceholder from '../components/FotoPlaceholder.astro';
import { BEDRIJF, USPS, WERKWIJZE, WERKGEBIED, WERKGEBIED_LANDELIJK } from '../consts';
import { alleDiensten } from '../lib/diensten';

import fotoOnderhoud from '../assets/stock/onderhoud-renovatie.jpg';

/*
 * Deze tekst bevat bewust geen oprichtingsjaar, aantal jaren ervaring,
 * teamgrootte of certificeringen. Die feiten kennen we niet en verzinnen we
 * niet. Zodra Prof Kluswerk ze aanlevert, kunnen ze hier in.
 * TODO: portretfoto en persoonlijk verhaal, zie PLAN.md §10.
 */
const diensten = await alleDiensten();

const uspIconen = ['medaille', 'handdruk', 'euro', 'klok'] as const;
---

<Base
  titel="Over ons | Klusbedrijf Prof Kluswerk Arnhem"
  omschrijving="Prof Kluswerk is een klusbedrijf uit Arnhem voor onderhoud, renovatie en afwerking. Eén aanspreekpunt voor uw hele klus, binnen en buiten."
>
  <section class="relative bg-navy-900 text-white">
    <div
      class="absolute inset-0 opacity-[0.06]"
      style="background-image: repeating-linear-gradient(135deg, #fff 0 1px, transparent 1px 14px);"
      aria-hidden="true"
    >
    </div>

    <div class="container-page relative pt-14 pb-20 lg:pt-20 lg:pb-28">
      <p class="eyebrow text-gold-500">Over ons</p>
      <h1 class="mt-3 max-w-3xl text-4xl uppercase sm:text-5xl">
        Eén vakman, de hele klus
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-navy-100">
        Prof Kluswerk is een klusbedrijf uit {BEDRIJF.standplaats}. Onderhoud,
        renovatie en afwerking, binnen en buiten, voor particulieren en
        bedrijven. Van een losse klus tot een woning die helemaal op de schop
        gaat.
      </p>
    </div>

    <BrushEdge class="text-white" />
  </section>

  <!-- ========================= WIE WIJ ZIJN ========================= -->
  <section class="bg-white py-16 lg:py-24" aria-labelledby="wie-kop">
    <div class="container-page grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="eyebrow text-gold-700">Wie u aan de lijn krijgt</p>
        <h2 id="wie-kop" class="mt-3 text-3xl uppercase sm:text-4xl">
          Geen callcenter,<br class="hidden sm:block" /> geen doorverwijzingen
        </h2>

        <div class="mt-6 space-y-4 text-lg leading-relaxed text-navy-700">
          <p>
            Bij de meeste klussen heeft u met drie of vier partijen te maken. De
            tegelzetter komt pas als de stukadoor klaar is, en die wacht weer op
            iemand anders. Als er iets misgaat, wijst iedereen naar de vorige.
          </p>
          <p>
            Bij ons belt u met één persoon, van de eerste vraag tot de
            oplevering. Diegene neemt de klus op, maakt de offerte, doet het werk
            en is degene die u belt als er iets tussenkomt.
          </p>
          <p>
            Dat is meteen de reden dat wij zes vakgebieden aanbieden in plaats
            van één. Niet om zo veel mogelijk te kunnen aannemen, maar omdat een
            klus zelden bij één vak blijft.
          </p>
        </div>
      </div>

      <div class="relative">
        <FotoPlaceholder
          label="Portretfoto Prof Kluswerk"
          icoon="gereedschap"
          class="aspect-[4/5] w-full rounded-2xl border border-navy-100"
        />
        <div
          class="absolute -bottom-5 -left-4 rotate-[-3deg] rounded-lg bg-gold-500 px-5 py-3 shadow-xl sm:-left-6"
        >
          <p class="font-display text-base leading-tight font-extrabold text-navy-900 italic">
            {BEDRIJF.payoff}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================== WAAR WIJ VOOR STAAN ======================== -->
  <section class="bg-shell py-16 lg:py-24" aria-labelledby="waarden-kop">
    <div class="container-page">
      <div class="max-w-2xl">
        <p class="eyebrow text-gold-700">Waar wij voor staan</p>
        <h2 id="waarden-kop" class="mt-3 text-3xl uppercase sm:text-4xl">
          Vier dingen die wij toezeggen
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-navy-700">
          Iedereen in deze branche noemt zichzelf betrouwbaar en vakkundig.
          Daarom hieronder wat wij er concreet mee bedoelen, zodat u ons eraan
          kunt houden.
        </p>
      </div>

      <ul class="mt-12 grid gap-8 sm:grid-cols-2">
        {
          USPS.map((usp, i) => (
            <li class="flex gap-5 rounded-2xl bg-white p-7">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-navy-900 text-gold-500">
                <Icon naam={uspIconen[i]} class="h-6 w-6" />
              </span>
              <div>
                <h3 class="font-display text-base font-extrabold tracking-wide text-navy-900 uppercase">
                  {usp.titel}
                </h3>
                <p class="mt-1.5 leading-relaxed text-navy-700">{usp.tekst}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ========================== HOE WIJ WERKEN ========================== -->
  <section class="bg-white py-16 lg:py-24" aria-labelledby="werkwijze-kop">
    <div class="container-page grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="eyebrow text-gold-700">Hoe wij werken</p>
        <h2 id="werkwijze-kop" class="mt-3 text-3xl uppercase sm:text-4xl">
          Van eerste telefoontje tot opgeruimde werkplek
        </h2>

        <ol class="mt-10 space-y-8">
          {
            WERKWIJZE.map((stap) => (
              <li class="flex gap-5">
                <span class="font-display text-3xl font-extrabold text-navy-100">
                  {stap.stap}
                </span>
                <div>
                  <h3 class="font-display text-base font-extrabold text-navy-900 uppercase">
                    {stap.titel}
                  </h3>
                  <p class="mt-1.5 leading-relaxed text-navy-700">{stap.tekst}</p>
                </div>
              </li>
            ))
          }
        </ol>

        <div class="mt-10 rounded-2xl border-l-4 border-gold-500 bg-shell p-6">
          <h3 class="font-display text-base font-extrabold text-navy-900 uppercase">
            Wat wij niet doen
          </h3>
          <p class="mt-2 leading-relaxed text-navy-700">
            Gas-, water- en elektrawerk laten wij over aan een erkend
            installateur. Dat hoort bij een gecertificeerd vakman en daar zijn
            wij eerlijk over. Wij regelen wel de afstemming en de planning,
            zodat u er geen omkijken naar heeft.
          </p>
        </div>
      </div>

      <div class="lg:col-span-5">
        <Image
          src={fotoOnderhoud}
          alt="Onderhoudswerk aan een gevel"
          widths={[440, 880]}
          sizes="(min-width: 1024px) 440px, 100vw"
          class="aspect-[3/4] w-full rounded-2xl border border-navy-100 object-cover"
        />
      </div>
    </div>
  </section>

  <!-- =========================== WERKGEBIED =========================== -->
  <section class="bg-navy-900 py-16 text-white lg:py-20" aria-labelledby="gebied-kop">
    <div class="container-page grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="eyebrow text-gold-500">Werkgebied</p>
        <h2 id="gebied-kop" class="mt-3 text-3xl uppercase sm:text-4xl">
          Thuis in Arnhem en omstreken
        </h2>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-navy-100">
          Wij werken vanuit {BEDRIJF.standplaats} en zijn dagelijks in de regio
          te vinden. Voor grotere projecten komen we door heel Nederland. Twijfelt
          u of u binnen ons gebied valt? Bel gerust even.
        </p>
        <div class="mt-8">
          <Button href={BEDRIJF.telefoonLink} formaat="lg">
            <Icon naam="telefoon" class="h-4 w-4" />
            {BEDRIJF.telefoonWeergave}
          </Button>
        </div>
      </div>

      <div>
        <h3 class="eyebrow text-navy-200">Dagelijks in de regio</h3>
        <ul class="mt-4 flex flex-wrap gap-2.5">
          {
            WERKGEBIED.map((plaats) => (
              <li class="flex items-center gap-1.5 rounded-full border border-navy-700 px-4 py-2 text-sm font-medium text-navy-100">
                <Icon naam="pin" class="h-3.5 w-3.5 text-gold-500" />
                {plaats}
              </li>
            ))
          }
        </ul>

        <h3 class="eyebrow mt-7 text-navy-200">Voor grotere projecten ook actief in</h3>
        <p class="mt-3 leading-relaxed text-navy-200">
          {WERKGEBIED_LANDELIJK.join(' · ')} en de rest van Nederland.
        </p>
      </div>
    </div>
  </section>

  <!-- ============================ DIENSTEN ============================ -->
  <section class="bg-white py-16 lg:py-20" aria-labelledby="diensten-kop">
    <div class="container-page">
      <h2 id="diensten-kop" class="eyebrow text-gold-700">Wat wij doen</h2>
      <ul class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          diensten.map((dienst) => (
            <li>
              <a
                href={`/diensten/${dienst.id}`}
                class="group flex h-full items-start gap-4 rounded-xl border border-navy-100 p-5 transition duration-300 ease-out-soft hover:-translate-y-0.5 hover:border-navy-200 hover:shadow-lg"
              >
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-navy-900 text-gold-500">
                  <Icon naam={dienst.data.icoon} class="h-5 w-5" />
                </span>
                <span>
                  <span class="block font-display text-[0.95rem] font-extrabold text-navy-900 uppercase">
                    {dienst.data.titel}
                  </span>
                  <span class="mt-1 block text-sm leading-relaxed text-navy-700">
                    {dienst.data.omschrijving}
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>
