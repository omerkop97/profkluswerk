---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import BrushEdge from '../components/BrushEdge.astro';
import CtaBand from '../components/CtaBand.astro';
import { BEDRIJF, WERKGEBIED, WERKGEBIED_LANDELIJK, OPENINGSTIJDEN } from '../consts';
---

<Base
  titel="Contact | Klusbedrijf Prof Kluswerk Arnhem"
  omschrijving="Neem contact op met Prof Kluswerk in Arnhem. Bel of app voor gratis advies en een vrijblijvende offerte. Reactie binnen één werkdag."
>
  <section class="relative bg-navy-900 text-white">
    <div
      class="absolute inset-0 opacity-[0.06]"
      style="background-image: repeating-linear-gradient(135deg, #fff 0 1px, transparent 1px 14px);"
      aria-hidden="true"
    >
    </div>

    <div class="container-page relative pt-14 pb-20 lg:pt-20 lg:pb-28">
      <p class="eyebrow text-gold-500">Contact</p>
      <h1 class="mt-3 max-w-3xl text-4xl uppercase sm:text-5xl">
        Even overleggen? Bel gerust
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-navy-100">
        De snelste manier is bellen of appen. Vaak weten we binnen vijf minuten
        waar het over gaat en of we u kunnen helpen. Liever schriftelijk? Vul
        dan het offerteformulier in.
      </p>
    </div>

    <BrushEdge class="text-white" />
  </section>

  <section class="bg-white pb-20 lg:pb-28">
    <div class="container-page grid gap-8 lg:grid-cols-3">
      <!-- Bellen -->
      <div class="flex flex-col rounded-2xl border border-navy-100 p-7">
        <span
          class="flex h-12 w-12 items-center justify-center rounded-full bg-navy-900 text-gold-500"
        >
          <Icon naam="telefoon" class="h-6 w-6" />
        </span>
        <h2 class="mt-5 font-display text-lg font-extrabold text-navy-900 uppercase">
          Bellen
        </h2>
        <p class="mt-2 flex-1 text-sm leading-relaxed text-navy-700">
          Direct antwoord op uw vraag. Krijgt u ons niet te pakken, dan staan we
          op de steiger. Spreek gerust in, we bellen terug.
        </p>
        <a
          href={BEDRIJF.telefoonLink}
          class="mt-5 font-display text-2xl font-extrabold text-navy-900 transition-colors hover:text-gold-700"
        >
          {BEDRIJF.telefoonWeergave}
        </a>
      </div>

      <!-- WhatsApp -->
      <div class="flex flex-col rounded-2xl border border-navy-100 p-7">
        <span
          class="flex h-12 w-12 items-center justify-center rounded-full bg-navy-900 text-gold-500"
        >
          <Icon naam="whatsapp" class="h-6 w-6" />
        </span>
        <h2 class="mt-5 font-display text-lg font-extrabold text-navy-900 uppercase">
          WhatsApp
        </h2>
        <p class="mt-2 flex-1 text-sm leading-relaxed text-navy-700">
          Handig als u een foto van de klus wilt sturen. Daarmee kunnen we vaak
          al meedenken zonder eerst langs te komen.
        </p>
        <div class="mt-5">
          <Button
            href={BEDRIJF.whatsapp}
            variant="outline-donker"
            target="_blank"
            rel="noopener noreferrer"
          >
            Stuur een bericht
          </Button>
        </div>
      </div>

      <!-- Offerte -->
      <div class="flex flex-col rounded-2xl border-2 border-gold-500 bg-gold-500/8 p-7">
        <span
          class="flex h-12 w-12 items-center justify-center rounded-full bg-gold-500 text-navy-900"
        >
          <Icon naam="check" class="h-6 w-6" />
        </span>
        <h2 class="mt-5 font-display text-lg font-extrabold text-navy-900 uppercase">
          Offerte aanvragen
        </h2>
        <p class="mt-2 flex-1 text-sm leading-relaxed text-navy-700">
          Vertel in het formulier wat er moet gebeuren en stuur eventueel foto's
          mee. U hoort binnen één werkdag van ons.
        </p>
        <div class="mt-5">
          <Button href="/offerte">
            Naar het formulier
            <Icon naam="pijl" class="h-4 w-4" />
          </Button>
        </div>
      </div>
    </div>

    <div class="container-page mt-12 grid gap-8 md:grid-cols-2">
      <!-- Openingstijden -->
      <div class="rounded-2xl bg-shell p-7">
        <h2 class="eyebrow flex items-center gap-2 text-gold-700">
          <Icon naam="klok" class="h-4 w-4" />
          Wanneer bereikbaar
        </h2>
        <dl class="mt-5 divide-y divide-navy-100">
          {
            OPENINGSTIJDEN.map((rij) => (
              <div class="flex items-center justify-between py-3">
                <dt class="text-navy-800">{rij.dag}</dt>
                <dd class="font-display text-sm font-bold text-navy-900">{rij.tijd}</dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-4 text-sm leading-relaxed text-navy-700">
          Overdag zijn we vaak aan het werk. Krijgt u geen gehoor, stuur dan een
          appje. Dat lezen we tussendoor.
        </p>
      </div>

      <!-- Werkgebied -->
      <div class="rounded-2xl bg-shell p-7">
        <h2 class="eyebrow flex items-center gap-2 text-gold-700">
          <Icon naam="pin" class="h-4 w-4" />
          Waar wij werken
        </h2>
        <p class="mt-5 leading-relaxed text-navy-700">
          Wij werken vanuit {BEDRIJF.standplaats} en zijn dagelijks in de regio
          te vinden. Voor grotere projecten komen we door heel Nederland.
        </p>
        <ul class="mt-5 flex flex-wrap gap-2">
          {
            WERKGEBIED.map((plaats) => (
              <li class="rounded-full border border-navy-100 bg-white px-3.5 py-1.5 text-sm font-medium text-navy-800">
                {plaats}
              </li>
            ))
          }
        </ul>

        <p class="mt-6 text-sm font-semibold text-navy-900">
          Voor grotere projecten ook actief in
        </p>
        <p class="mt-2 text-sm leading-relaxed text-navy-700">
          {WERKGEBIED_LANDELIJK.join(' · ')} en de rest van Nederland.
        </p>

        <p class="mt-5 text-sm leading-relaxed text-navy-700">
          Wij komen naar u toe, er is geen showroom of bezoekadres. Het opnemen
          van de klus gebeurt bij u op locatie en is gratis.
        </p>
      </div>
    </div>
  </section>

  <CtaBand
    kop="Liever meteen een prijs?"
    tekst="Vul het offerteformulier in en stuur wat foto's mee. Binnen één werkdag weet u waar u aan toe bent."
  />
</Base>
